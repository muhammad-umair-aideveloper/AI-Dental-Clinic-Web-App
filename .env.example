# ==========================================
# Lahore Dental - Environment Configuration
# ==========================================

# Supabase (Postgres Database for Appointments)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Calendar Integration (for slot availability & events)
GOOGLE_CALENDAR_ID=your_clinic_calendar_id@group.calendar.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Resend (Email confirmations & contact form submissions)
RESEND_API_KEY=re_your_resend_api_key_here
CLINIC_ADMIN_EMAIL=appointments@lahoredental.pk

# Twilio (WhatsApp booking confirmations)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Staff Authentication Session Secret
AUTH_SECRET=your_auth_session_secret_min_32_characters_here
ADMIN_DEFAULT_PASSWORD=your_secure_staff_password_here

# Gemini API (Phase 2: AI Chatbot — server-side only, never expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Cron Secret (Phases 5 & 6: protected scheduler endpoints)
# Generate: openssl rand -hex 32
CRON_SECRET=your_cron_secret_min_32_characters_here

# Google Sheets (Phase 4: append row on booking)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Supabase is required for appointment, patient, inquiry, and staff-user persistence.
# Keep SUPABASE_SERVICE_ROLE_KEY server-only; never expose it with NEXT_PUBLIC_.
