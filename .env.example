# ==========================================
# Lahore Dental - Environment Configuration
# ==========================================

# OpenAI API Configuration (for GPT-4o-mini streaming chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase (Postgres Database for Appointments)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Calendar Integration (for slot availability & events)
GOOGLE_CALENDAR_ID=your_clinic_calendar_id@group.calendar.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Resend (Email confirmations & contact form submissions)
RESEND_API_KEY=re_your_resend_api_key_here
CLINIC_ADMIN_EMAIL=appointments@lahoredental.pk

# Twilio (WhatsApp booking confirmations)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Clerk Authentication (Patient Sign-Up & Sign-In)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Note: The application includes smart mock/offline fallbacks.
# If these environment variables are unset, the app will run in demo mode
# with in-memory storage, simulated calendar slots, and console notifications.
